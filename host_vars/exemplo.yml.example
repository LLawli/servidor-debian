---
# Variáveis de um servidor: host_vars/<nome>.yml (fica fora do git, pode ter senhas).
# O bin/novo-servidor gera este arquivo com o que detectar no servidor.

servidor_modulos: [base, confiabilidade, notebook, rede, firewall]

base_chaves_ssh:
  - "{{ lookup('ansible.builtin.file', '~/.ssh/id_ed25519.pub') }}"
base_travar_kernel: false

confiabilidade_tpm: true

rede_dns: [192.168.1.1]
rede_interfaces:
  - nome: wlp3s0
    dhcp: true
    identificador_dhcp: mac
    wifi:
      ssid: MinhaRede
      senha: "troque-esta-senha"

firewall_zonas:
  - nome: lan
    interface: wlp3s0
    origem: 192.168.1.0/24
    tcp: [22]
